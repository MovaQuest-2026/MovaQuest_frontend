                  ],
                  "nop",
                  "\n",
                  "ev",
                  true,
                  "/ev",
                  {
                    "VAR=": "task_dessert",
                    "re": true
                  },
                  {
                    "->": "0.g-1"
                  },
                  {
                    "#f": 5
                  }
                ],
                "c-3": [
                  "\n",
                  "^Okay. I'm here if you change your mind.",
                  "\n",
                  {
                    "->": "0.g-1"
                  },
                  {
                    "#f": 5
                  }
                ]
