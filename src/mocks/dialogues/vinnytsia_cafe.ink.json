          ],
          "nop",
          "\n",
          "^Hi! «Що будеш?» What will you have? ",
          "#",
          "^speaker:npc_barista",
          "/#",
          "\n",
          "ev",
          "str",
          "^Каву з молоком, будь ласка. (Coffee with milk, please.)",
          "/str",
          "/ev",
          {
            "*": "0.c-0",
            "flg": 20
          },
          "ev",
          "str",
          "^Чорну каву без цукру. (Black coffee, no sugar.)",
          "/str",
          "/ev",
          {
            "*": "0.c-1",
            "flg": 20
          },
          {
            "c-0": [
              "\n",
              "ev",
              true,
              "/ev",
              {
                "VAR=": "polite",
                "re": true
              },
              "^One coffee with milk, «з молоком»!",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "c-1": [
              "\n",
              "^Black, «без цукру». Sure.",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "g-0": [
              "^And a dessert, «десерт»?",
              "\n",
              "ev",
              "str",
              "^Мені потрібен десерт для подруги. (I need a dessert for a friend.)",
              "/str",
              "/ev",
              {
                "*": ".^.c-2",
                "flg": 20
              },
              "ev",
              "str",
              "^Ні, дякую. (No, thanks.)",
              "/str",
              "/ev",
              {
                "*": ".^.c-3",
                "flg": 20
              },
              {
                "c-2": [
                  "\n",
                  "^Who's your friend? Maybe I know her. Describe her. ",
                  "#",
                  "^quiz:cafe_describe_1",
                  "/#",
                  "\n",
                  "ev",
                  {
                    "VAR?": "quiz_ok"
                  },
                  "/ev",
                  [
                    {
                      "->": ".^.b",
                      "c": true
                    },
                    {
                      "b": [
                        "\n",
                        "^Solomiia! The volunteer who gives tours? Of course! She always takes the cherry strudel.",
                        "\n",
                        "^Here you go. ",
                        "#",
                        "^give:dessert",
                        "/#",
                        "\n",
                        "ev",
                        {
                          "VAR?": "trust"
                        },
                        1,
                        "+",
                        {
                          "VAR=": "trust",
                          "re": true
                        },
                        "/ev",
                        {
                          "->": ".^.^.^.11"
                        },
                        null
                      ]
                    }
                  ],
                  [
                    {
                      "->": ".^.b"
                    },
                    {
                      "b": [
                        "\n",
                        "^Hm, doesn't ring a bell... Take the cherry strudel, «вишневий штрудель», everyone loves it. ",
                        "#",
                        "^give:dessert",
                        "/#",
                        "\n",
                        {
                          "->": ".^.^.^.11"
                        },
                        null
