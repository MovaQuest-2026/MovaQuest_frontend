              }
            ],
            [
              {
                "->": ".^.b"
              },
              {
                "b": [
                  "\n",
                  "^It's r. «Р» only looks like an English P.",
                  "\n",
                  {
                    "->": "lesson.29"
                  },
                  null
                ]
              }
            ],
            "nop",
            "\n",
            "^And this one means \"she\". ",
            "#",
            "^quiz:alpha_false_2",
