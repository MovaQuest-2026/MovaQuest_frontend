                "\n",
                {
                  "->": "offer"
                },
                {
                  "->": "0.15"
                },
                null
              ]
            }
          ],
          "nop",
          "\n",
          "^Hi! I'm Marta. Your bus to Vinnytsia leaves soon, so let's learn the Ukrainian alphabet, «абетка». It has 33 letters. ",
          "#",
          "^speaker:npc_marta",
          "/#",
          "\n",
