                },
                null
              ],
              "s1": [
                "pop",
                "^No, I'm Oksana. Thanks for asking though!",
                {
                  "->": "0.1.35"
                },
                null
              ],
              "s2": [
                "pop",
                "^Solomiia? No, I'm here with my grandson, «онук».",
