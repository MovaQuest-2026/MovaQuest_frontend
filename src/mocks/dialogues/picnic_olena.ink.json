                    {
                      "->": ".^.b"
                    },
                    {
                      "b": [
                        "\n",
                        "^Not quite, but look: «торт» is torte, «лимонад» is lemonade.",
                        "\n",
                        {
                          "->": ".^.^.^.5"
                        },
                        null
                      ]
                    }
