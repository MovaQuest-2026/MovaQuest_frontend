                  "nop",
                  "\n",
                  {
                    "->": "lesson.19"
                  },
                  null
                ]
              }
            ],
            [
              {
                "->": ".^.b"
              },
              {
                "b": [
                  "\n",
                  "^It's Ш. Щ has a little tail and sounds like shch.",
                  "\n",
                  {
                    "->": "lesson.19"
                  },
                  null
                ]
              }
            ],
            "nop",
