          },
          "/ev",
          [
            {
              "->": ".^.b",
              "c": true
            },
            {
              "b": [
                "\n",
                "^Пирогов був хірургом, пам'ятаєш? Обходь по Соборній, не заблукаєш. ",
                "#",
                "^speaker:npc_ostap",
                "/#",
                "\n",
                "end",
                {
                  "->": "0.11"
                },
                null
              ]
            }
          ],
          "nop",
          "\n",
          "^Привіт! Я Остап, вчуся на лікаря в медичному університеті імені Пирогова. Знаєш про нього? ",
          "#",
          "^speaker:npc_ostap",
          "/#",
          "\n",
          "ev",
          "str",
          "^Ні, хто це?",
          "/str",
          "/ev",
          {
            "*": "0.c-0",
            "flg": 20
          },
          "ev",
          "str",
          "^Трохи. Розкажи!",
          "/str",
          "/ev",
          {
            "*": "0.c-1",
            "flg": 20
          },
          {
            "c-0": [
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "c-1": [
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "g-0": [
              "^Микола Пирогов був великим хірургом. Одним із перших оперував з ефірним наркозом просто на війні.",
              "\n",
              "^Останні роки він жив тут, біля Вінниці, у садибі Вишня. Зараз там музей.",
              "\n",
              "^Ну що, перевіримо? Ким був Пирогов? ",
              "#",
              "^quiz:pirogov_1",
              "/#",
              "\n",
              "ev",
              true,
              "/ev",
              {
                "VAR=": "pirogov_asked",
                "re": true
              },
              "ev",
              {
                "VAR?": "quiz_ok"
              },
              "/ev",
              [
                {
                  "->": ".^.b",
                  "c": true
                },
                {
                  "b": [
                    "\n",
                    "^Точно! Ти уважно слухаєш.",
                    "\n",
                    "ev",
                    true,
                    "/ev",
                    {
                      "VAR=": "knows_pirogov",
                      "re": true
                    },
                    "ev",
                    {
                      "VAR?": "trust"
                    },
                    1,
                    "+",
                    {
                      "VAR=": "trust",
                      "re": true
                    },
                    "/ev",
                    "^Іди через цей двір, так до Мурів швидше. ",
                    "#",
                    "^flag:shortcut_open",
                    "/#",
                    "\n",
                    {
                      "->": "0.g-0.18"
                    },
                    null
                  ]
                }
              ],
              [
                {
                  "->": ".^.b"
                },
                {
                  "b": [
                    "\n",
                    "^Не зовсім. Він був хірургом, тобто лікарем, який робить операції.",
                    "\n",
                    "^Тримай листівку, там коротко. ",
                    "#",
                    "^give:pirogov_card",
                    "/#",
                    "\n",
                    "^Обходь по Соборній, не заблукаєш.",
                    "\n",
                    {
                      "->": "0.g-0.18"
                    },
                    null
