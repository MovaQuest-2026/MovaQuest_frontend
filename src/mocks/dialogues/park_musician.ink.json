  "inkContent": {
    "en": {
      "inkVersion": 21,
      "root": [
        [
          "\n",
          "^Hi! Want a song? I play here every day, «кожного дня». ",
          "#",
          "^speaker:npc_musician",
          "/#",
          "\n",
          "ev",
          "str",
          "^Так, заграй, будь ласка! (Yes, play please!)",
          "/str",
          "/ev",
          {
            "*": "0.c-0",
            "flg": 20
          },
          "ev",
          "str",
          "^Ні, дякую. Як дійти до Соборної? (No, thanks. How do I get to Soborna?)",
          "/str",
          "/ev",
          {
            "*": "0.c-1",
            "flg": 20
          },
          {
            "c-0": [
              "\n",
              "ev",
              true,
              "/ev",
              {
                "VAR=": "polite",
                "re": true
              },
              "ev",
              {
                "VAR?": "trust"
              },
              1,
              "+",
              {
                "VAR=": "trust",
                "re": true
              },
              "/ev",
              "^Here's a song about the Southern Bug, «Південний Буг». Our river, our music.",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "c-1": [
              "\n",
              "^Pity! Then listen.",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "g-0": [
              "^Go «прямо» through the park, then «праворуч», and you're on Soborna. ",
              "#",
              "^flag:park_route_known",
              "/#",
              "\n",
              "end",
              [
                "done",
                {
                  "#n": "g-1"
                }
