  "inkContent": {
    "en": {
      "inkVersion": 21,
      "root": [
        [
          "\n",
          "ev",
          {
            "VAR?": "has_umbrella"
          },
          {
            "VAR?": "has_drawing"
          },
          "||",
          "/ev",
          [
            {
              "->": ".^.b",
              "c": true
            },
            {
              "b": [
                "\n",
                "^The rain is stopping. Off you go, and don't lose the umbrella, «парасолька»! ",
                "#",
                "^speaker:npc_galyna",
                "/#",
                "\n",
                "end",
                {
                  "->": "0.7"
                },
                null
              ]
            }
          ],
          "nop",
          "\n",
          "^Oh, you're soaked! Come in out of the rain. «Чаю хочеш?» Want some tea? ",
          "#",
          "^speaker:npc_galyna",
          "/#",
          "\n",
          "ev",
          "str",
          "^Так, дякую! (Yes, thank you!)",
          "/str",
          "/ev",
          {
            "*": "0.c-0",
            "flg": 20
          },
          "ev",
          "str",
          "^Чай. Давайте. (Tea. Give it.)",
          "/str",
          "/ev",
          {
            "*": "0.c-1",
            "flg": 20
          },
          {
            "c-0": [
              "\n",
              "ev",
              true,
              "/ev",
              {
                "VAR=": "polite",
                "re": true
              },
              "^Here, raspberry tea. «Звідки ти?» Where are you from?",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "c-1": [
              "\n",
              "^Well... here's tea. «Звідки ти?» Where are you from?",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "g-0": [
              "ev",
              "str",
              "^Я тут уперше. Їду до фонтану. (It's my first time here. I'm going to the fountain.)",
              "/str",
              "/ev",
              {
                "*": ".^.c-2",
                "flg": 20
              },
              "ev",
              "str",
              "^Здалеку. (From far away.)",
              "/str",
              "/ev",
              {
                "*": ".^.c-3",
                "flg": 20
              },
              {
                "c-2": [
                  "\n",
                  "^The Roshen fountain? Lovely! There's a show in the evening.",
                  "\n",
                  {
                    "->": "0.g-1"
                  },
                  {
                    "#f": 5
                  }
                ],
                "c-3": [
                  "\n",
                  "^From far away? Then all the more welcome.",
                  "\n",
                  {
                    "->": "0.g-1"
                  },
                  {
                    "#f": 5
                  }
                ]
              }
            ],
            "g-1": [
              "^This is Vyshenka, a quiet residential district with lots of green. My kids grew up here.",
              "\n",
              "^More tea? ",
              "#",
              "^quiz:vysh_polite_1",
              "/#",
              "\n",
              "ev",
              {
                "VAR?": "quiz_ok"
              },
              {
                "VAR?": "polite"
              },
              "||",
              "/ev",
              [
                {
                  "->": ".^.b",
                  "c": true
                },
                {
                  "b": [
                    "\n",
                    "^Such a polite guest! Take an umbrella, «парасолька», I have three. ",
                    "#",
                    "^give:umbrella",
                    "/#",
                    "\n",
                    "ev",
                    true,
                    "/ev",
                    {
                      "VAR=": "has_umbrella",
                      "re": true
                    },
                    "ev",
                    {
                      "VAR?": "trust"
                    },
                    1,
                    "+",
                    {
                      "VAR=": "trust",
                      "re": true
                    },
                    "/ev",
                    {
                      "->": "0.g-1.14"
                    },
                    null
                  ]
                }
              ],
              [
                {
                  "->": ".^.b"
                },
                {
                  "b": [
                    "\n",
                    "^All right. The rain will pass soon.",
                    "\n",
                    {
                      "->": "0.g-1.14"
                    },
                    null
                  ]
                }
              ],
              "nop",
              "\n",
              "^The rain is over. The trolleybus stop is just around the corner. ",
              "#",
              "^clock:12:00",
              "/#",
              "\n",
              "end",
              [
                "done",
                {
                  "#n": "g-2"
                }
              ],
              null
