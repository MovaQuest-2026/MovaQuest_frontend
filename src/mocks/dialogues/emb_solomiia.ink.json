                      "->": "0.g-0.11"
                    },
                    null
                  ]
                }
              ],
              [
                "ev",
                {
                  "VAR?": "trust"
                },
                3,
                ">=",
                "/ev",
                {
                  "->": ".^.b",
                  "c": true
                },
                {
