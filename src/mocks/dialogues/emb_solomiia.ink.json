        ],
        "done",
        {
          "ending_best": [
            "^Grandma says everyone is invited to dinner: you, me, and the artist from Mury. ",
            "#",
            "^ending:best",
            "/#",
            "\n",
            "^See all those people waving at you? Nina, Halyna, Ostap... The city remembers you.",
            "\n",
            "end",
            null
          ],
          "ending_good": [
            "^Come to our place for dinner, I'll introduce you to my family. ",
            "#",
            "^ending:good",
            "/#",
            "\n",
            "end",
            null
          ],
          "ending_basic": [
            "^The main thing is you made it! Next time we'll do a tour together. ",
            "#",
            "^ending:basic",
            "/#",
            "\n",
            "end",
            null
          ],
