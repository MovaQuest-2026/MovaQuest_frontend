    "uk": {
      "inkVersion": 21,
      "root": [
        [
          "\n",
          "^Перший раз у Вінниці? Бачу, все роздивляєшся. ",
          "#",
          "^speaker:npc_passenger",
          "/#",
          "\n",
          "ev",
          "str",
          "^Так, перший раз.",
          "/str",
          "/ev",
          {
            "*": "0.c-0",
            "flg": 20
          },
          "ev",
          "str",
          "^Так. А куди ми їдемо?",
          "/str",
          "/ev",
          {
            "*": "0.c-1",
            "flg": 20
          },
          {
            "c-0": [
              "\n",
              "^О, то дивись у вікно. Бачиш трамвай? Наші трамваї колись їздили у Швейцарії.",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "c-1": [
              "\n",
              "^До центру, на Соборну. Це наша головна вулиця.",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "g-0": [
              "^Ой, оголошення, слухай!",
              "\n",
              "^Увага! Наступна зупинка: «Центральний парк». А вам треба на Соборну. Що робите? ",
              "#",
              "^quiz:trolley_stop_1",
              "/#",
              "\n",
              "ev",
              {
                "VAR?": "quiz_ok"
              },
              "/ev",
              [
                {
                  "->": ".^.b",
                  "c": true
                },
                {
                  "b": [
                    "\n",
                    "^Правильно, сиди. Твоя наступна. Ось і Соборна!",
                    "\n",
                    "ev",
                    true,
                    "/ev",
                    {
                      "VAR=": "stop_ok",
                      "re": true
                    },
                    {
                      "->": "0.g-0.12"
                    },
                    null
                  ]
                }
              ],
              [
                {
                  "->": ".^.b"
                },
                {
                  "b": [
                    "\n",
                    "^Ой, ти вже на вулиці?.. Нічого, через парк теж дійдеш до центру!",
                    "\n",
                    "ev",
                    false,
                    "/ev",
                    {
                      "VAR=": "stop_ok",
                      "re": true
                    },
                    {
                      "->": "0.g-0.12"
                    },
                    null
                  ]
                }
              ],
              "nop",
              "\n",
              "end",
              [
                "done",
                {
                  "#n": "g-1"
                }
              ],
              null
            ]
