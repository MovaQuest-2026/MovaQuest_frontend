    "uk": {
      "inkVersion": 21,
      "root": [
        [
          "\n",
          "^Проїзд оплачуємо! Готівка чи картка? ",
          "#",
          "^speaker:npc_conductor",
          "/#",
          "\n",
          "ev",
          "str",
          "^Спитати про оплату",
          "/str",
          "/ev",
          {
            "*": "0.c-0",
            "flg": 20
          },
          "ev",
          "str",
          "^Мовчки показати картку",
          "/str",
          "/ev",
          {
            "*": "0.c-1",
            "flg": 20
          },
          {
            "c-0": [
              "\n",
              "^Ну? Кажіть, я слухаю. ",
              "#",
              "^quiz:trolley_card_1",
              "/#",
              "\n",
              "ev",
              {
                "VAR?": "quiz_ok"
              },
              "/ev",
              [
                {
                  "->": ".^.b",
                  "c": true
                },
                {
                  "b": [
                    "\n",
                    "^Можна, звісно. Прикладайте до терміналу. Ось ваш квиток.",
                    "\n",
                    "ev",
                    {
                      "VAR?": "trust"
                    },
                    1,
                    "+",
                    {
                      "VAR=": "trust",
                      "re": true
                    },
                    "/ev",
                    {
                      "->": "0.c-0.11"
                    },
                    null
                  ]
                }
              ],
              [
                {
                  "->": ".^.b"
                },
                {
                  "b": [
                    "\n",
                    "^Не зрозуміла... А, картка! Так, можна. Ось термінал.",
                    "\n",
                    {
                      "->": "0.c-0.11"
                    },
                    null
                  ]
                }
              ],
              "nop",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "c-1": [
              "\n",
              "^А, картка. Прикладайте сюди.",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "g-0": [
              "^Слухайте оголошення, щоб не проїхати свою зупинку!",
              "\n",
              "end",
              [
                "done",
                {
                  "#n": "g-1"
