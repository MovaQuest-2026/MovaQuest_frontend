  "inkContent": {
    "en": {
      "inkVersion": 21,
      "root": [
        [
          "\n",
          "^Your phone finally comes alive. A message from Solomiia: ",
          "#",
          "^speaker:phone ",
          "/#",
          "#",
          "^clock:19:30",
          "/#",
          "\n",
          "^«Я трохи запізнююсь! Шукай мене біля мосту: червона куртка й окуляри.»",
          "\n",
          "^Who are you looking for? ",
          "#",
          "^quiz:emb_find_1",
          "/#",
          "\n",
          "ev",
          {
            "VAR?": "quiz_ok"
          },
          "/ev",
          [
            {
              "->": ".^.b",
              "c": true
            },
            {
              "b": [
                "\n",
                "^Red jacket, «червона куртка», glasses, «окуляри», by the bridge. Let's go! ",
                "#",
                "^flag:know_outfit",
                "/#",
                "\n",
                {
                  "->": "0.21"
                },
                null
              ]
            }
          ],
          [
            {
              "->": ".^.b"
            },
            {
              "b": [
                "\n",
                "^You read it again: «червона куртка й окуляри», a red jacket and glasses. ",
                "#",
                "^flag:know_outfit",
                "/#",
                "\n",
                {
                  "->": "0.21"
                },
                null
              ]
            }
          ],
          "nop",
          "\n",
          "end",
          [
            "done",
