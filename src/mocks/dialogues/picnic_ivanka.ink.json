              "b": [
                "\n",
                "^«Привіт! Мама чекає біля ковдри.» (Hi! Mom is waiting by the blanket.) Maybe you should talk to her first. ",
                "#",
                "^speaker:npc_ivanka",
                "/#",
                "\n",
