  "inkContent": {
    "en": {
      "inkVersion": 21,
      "root": [
        [
          "\n",
          "ev",
          {
            "VAR?": "has_drawing"
          },
          "/ev",
          [
            {
              "->": ".^.b",
              "c": true
            },
            {
              "b": [
                "\n",
                "^Let the drawing, «малюнок», remind you of Vinnytsia. ",
                "#",
                "^speaker:npc_artist",
                "/#",
                "\n",
                "end",
                {
                  "->": "0.5"
                },
                null
              ]
            }
          ],
          "nop",
          "\n",
          "^Oh, rain again, «знову дощ»! My sketches will get wet... ",
          "#",
          "^speaker:npc_artist",
          "/#",
          "\n",
          "ev",
          "str",
          "^Тримайте мою парасольку! (Take my umbrella!)",
          "/str",
          {
            "VAR?": "has_umbrella"
          },
          "/ev",
          {
            "*": "0.c-0",
            "flg": 21
          },
          "ev",
          "str",
          "^Що ви малюєте? (What are you drawing?)",
          "/str",
          "/ev",
          {
            "*": "0.c-1",
            "flg": 20
          },
          "ev",
          "str",
          "^Вибачте, у мене немає парасольки. (Sorry, I don't have an umbrella.)",
          "/str",
          "/ev",
          {
            "*": "0.c-2",
            "flg": 20
          },
          {
            "c-0": [
              "\n",
              "^Really? Thank you, you're saving me! ",
              "#",
              "^take:umbrella",
              "/#",
              "\n",
              "ev",
              false,
              "/ev",
              {
                "VAR=": "has_umbrella",
                "re": true
              },
              "^Here, take this drawing of the fountain. I made it yesterday on the embankment. ",
              "#",
              "^give:drawing",
              "/#",
              "\n",
              "ev",
              true,
              "/ev",
              {
                "VAR=": "has_drawing",
                "re": true
              },
              "ev",
              {
                "VAR?": "trust"
              },
              1,
              "+",
              {
                "VAR=": "trust",
                "re": true
              },
              "/ev",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "c-1": [
              "\n",
              "^Mury, \"the Walls\". There used to be a monastery here, now there are exhibitions and cafés.",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "c-2": [
              "\n",
              "^No worries, I'll hide under the arch.",
              "\n",
              {
                "->": "0.g-0"
              },
              {
                "#f": 5
              }
            ],
            "g-0": [
              "end",
