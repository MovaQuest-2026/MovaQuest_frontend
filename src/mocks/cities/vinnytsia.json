  "zoneIntros": {
    "glade": {
      "title": { "en": "Prologue: the glade", "uk": "Пролог: галявина" },
      "text": {
        "en": "A quiet morning outside the city. In an hour a bus will take you to Vinnytsia, where Solomiia is waiting. Until then, two volunteers of a language picnic will help you learn the Ukrainian alphabet.",
        "uk": "Тихий ранок за містом. Через годину автобус повезе тебе до Вінниці, де на тебе чекає Соломія. А поки двоє волонтерок мовного пікніка допоможуть вивчити українську абетку."
      }
    }
  },
