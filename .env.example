# PostHog analytics
# Project API key from PostHog → Project settings → Project API key
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
# PostHog ingestion host (use https://eu.i.posthog.com for EU-hosted projects)
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Вхід через Google (Google Identity Services). OAuth client ID типу «Web application»
# з Google Cloud Console; в Authorized JavaScript origins додай адреси застосунку
# (http://localhost:5173, домен Vercel). Без ключа: у dev тестовий акаунт, у продакшені кнопка дає помилку.
VITE_GOOGLE_CLIENT_ID=
