# Скопіюйте в .env (або .env.local) і за потреби змініть. Vite читає змінні лише на старті: після правок перезапустіть `npm run dev`.

# --- Бекенд ---
# Куди Vite проксіює /api для `npm run dev` / `preview` (на Vercel те саме робить vercel.json).
# Порожньо = https://backend-hb2j.onrender.com. Локальний бекенд: http://localhost:8000
# Google-вхід ключів на фронті не потребує: client ID і secret живуть на бекенді.
VITE_API_PROXY_TARGET=

# --- Розпізнавання мови ---
# По-справжньому: POST /api/v1/transcription (Deepgram Nova-3) через бекенд.
# true — мок без бекенду (випадкові вердикти, для розробки без мережі). Усе інше, зокрема false, — справжній бекенд.
VITE_MOCK_SPEECH=false

# --- Соціальні функції ---
# Лайки, збереження, лічильники, коментарі, поширення йдуть на бекенд. true — мок без бекенду.
VITE_MOCK_SOCIAL=false
# До справжніх лічильників і коментарів додається мок-база з src/mocks/social (накрутка). false — лише дані бекенду.
VITE_SOCIAL_SEED=true

# --- Профіль ---
# Онбординг (мова, рівень, мета) зберігається на бекенді (/api/v1/me/profile). true — мок у localStorage.
VITE_MOCK_PROFILE=false

# --- Прогрес ---
# Пройдені уроки, вивчені слова й незавершені уроки акаунта йдуть на бекенд (/api/v1/me/progress). true — мок у localStorage.
VITE_MOCK_PROGRESS=false

# --- PostHog (необов'язково) ---
# Без VITE_POSTHOG_KEY аналітика вимкнена і запити до PostHog не робляться.
# Project API key: PostHog → Project settings → Project API key
# VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
# Хост (для EU-проєктів https://eu.i.posthog.com)
# VITE_POSTHOG_HOST=https://us.i.posthog.com
