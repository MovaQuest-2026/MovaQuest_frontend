# PostHog analytics
# Project API key from PostHog → Project settings → Project API key
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
# PostHog ingestion host (use https://eu.i.posthog.com for EU-hosted projects)
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Бекенд для `npm run dev` / `preview`: Vite проксіює /api сюди (на Vercel те саме робить vercel.json).
# За замовчуванням https://backend-hb2j.onrender.com. Локальний бекенд: http://localhost:8000
# VITE_MOCK_SPEECH=true — розпізнавання-мок без бекенду (голос на бекенді вимагає входу в акаунт)
# Google-вхід ключів на фронті не потребує: client ID і secret живуть на бекенді.
VITE_API_PROXY_TARGET=
